// © Indicator
//@version=5
// =====================================================================
//  VWAP + EMA(9) trend, EMA(5)/EMA(20) momentum — No-Repaint arrows
// ---------------------------------------------------------------------
//  Strategy logic (mirror of the MT5 VWAP_EMA_Signal indicator)
//    * Trend    : EMA(9) vs VWAP        (EMA9 > VWAP = bullish)
//    * Momentum : EMA(5) - EMA(20) gap  (wider/expanding = stronger)
//    * Signal   : arrow when trend + momentum align (edge trigger)
//
//  No-Repaint: signals are evaluated on the previous CLOSED bar and
//  drawn with offset = -1, so a printed arrow never moves or vanishes.
// =====================================================================
indicator("VWAP + EMA Signal", overlay = true, max_labels_count = 500)

// ------------------------- Inputs ------------------------------------
grpEMA   = "EMA settings"
emaFastLen = input.int(5,  "Fast EMA (momentum)", minval = 1, group = grpEMA)
emaMidLen  = input.int(9,  "Mid EMA (trend, w/ VWAP)", minval = 1, group = grpEMA)
emaSlowLen = input.int(20, "Slow EMA (momentum)", minval = 1, group = grpEMA)
emaSrc     = input.source(close, "EMA source", group = grpEMA)

grpMom   = "Momentum (EMA5-EMA20 spread)"
minSpreadTicks   = input.float(50, "Min |EMA5-EMA20| (ticks)", minval = 0, group = grpMom)
requireExpanding = input.bool(true, "Require spread to be widening", group = grpMom)

grpTrend = "Trend strength (EMA9-VWAP gap)"
minVwapGapTicks = input.float(0, "Min |EMA9-VWAP| (ticks, 0 = direction only)", minval = 0, group = grpTrend)
vwapExpanding   = input.bool(false, "Require EMA9-VWAP gap to be widening", group = grpTrend)

grpBB    = "Volatility (Bollinger Band width)"
bbLen        = input.int(20, "BB period", minval = 1, group = grpBB)
bbDev        = input.float(2.0, "BB deviations", minval = 0.1, group = grpBB)
bbSrc        = input.source(close, "BB source", group = grpBB)
bbExpanding      = input.bool(true, "Require upper/lower band to be spreading apart", group = grpBB)
bbExpandLookback = input.int(1, "Expansion lookback (bars)", minval = 1, group = grpBB)
minBBWidthPct    = input.float(0, "Extra: min width as % of basis (0 = off)", minval = 0, group = grpBB)

grpVWAP  = "VWAP"
vwapSrc  = input.source(hlc3, "VWAP source", group = grpVWAP)
vwapAnchor = input.string("Session", "VWAP anchor", options = ["Session", "Week", "Month"], group = grpVWAP)

grpDisp  = "Display"
showEMAs   = input.bool(true, "Plot EMAs & VWAP", group = grpDisp)
colorTrend = input.bool(true, "Color background by trend", group = grpDisp)

// ------------------------- Calculations ------------------------------
emaFast = ta.ema(emaSrc, emaFastLen)
emaMid  = ta.ema(emaSrc, emaMidLen)
emaSlow = ta.ema(emaSrc, emaSlowLen)

// Anchored VWAP: reset at the chosen period boundary
newPeriod = switch vwapAnchor
    "Week"  => timeframe.change("W")
    "Month" => timeframe.change("M")
    => timeframe.change("D")               // Session (daily)
vwapValue = ta.vwap(vwapSrc, newPeriod)

// Bollinger Bands — only the upper/lower distance matters (basis ignored)
bbBasis = ta.sma(bbSrc, bbLen)
bbDevAbs = bbDev * ta.stdev(bbSrc, bbLen)
bbUpper = bbBasis + bbDevAbs
bbLower = bbBasis - bbDevAbs
bbWidth = bbUpper - bbLower                  // distance between upper & lower
bbWidthPct = bbBasis != 0 ? bbWidth / math.abs(bbBasis) * 100 : 0.0

// Volatility gate: bands spreading apart (widening) = volatility / volume in.
volExpandOk = not bbExpanding or (bbWidth > bbWidth[bbExpandLookback])
volFloorOk  = minBBWidthPct <= 0 or (bbWidthPct >= minBBWidthPct)
volOk = volExpandOk and volFloorOk

minGap  = minSpreadTicks * syminfo.mintick
minVGap = minVwapGapTicks * syminfo.mintick
spread  = emaFast - emaSlow                 // EMA5 - EMA20
vgap    = emaMid - vwapValue                // EMA9 - VWAP

// Directional state per bar: +1 bull aligned, -1 bear aligned, 0 none
f_state(_spread, _spreadPrev, _vgap, _vgapPrev, _volOk) =>
    // Trend strength from EMA9-VWAP gap magnitude
    trendUp   = _vgap >  minVGap
    trendDown = _vgap < -minVGap
    if vwapExpanding
        trendUp   := trendUp   and _vgap > _vgapPrev
        trendDown := trendDown and _vgap < _vgapPrev
    // Momentum from EMA5-EMA20 spread
    momUp   = _spread >  minGap
    momDown = _spread < -minGap
    if requireExpanding
        momUp   := momUp   and _spread > _spreadPrev
        momDown := momDown and _spread < _spreadPrev
    // Volatility gate (Bollinger bands widening) must also pass
    not _volOk ? 0 : trendUp and momUp ? 1 : trendDown and momDown ? -1 : 0

state     = f_state(spread,    spread[1], vgap,    vgap[1], volOk)
statePrev = f_state(spread[1], spread[2], vgap[1], vgap[2], volOk[1])

// Edge trigger: alignment appears for the first time
buyRaw  = state ==  1 and statePrev !=  1
sellRaw = state == -1 and statePrev != -1

// ---- No-Repaint: evaluate on the closed bar, draw with offset = -1 ----
buySignal  = buyRaw[1]
sellSignal = sellRaw[1]

// ------------------------- Plots -------------------------------------
plot(showEMAs ? emaFast : na, "EMA Fast", color = color.new(color.aqua, 0),   linewidth = 1)
plot(showEMAs ? emaMid  : na, "EMA Mid",  color = color.new(color.yellow, 0), linewidth = 2)
plot(showEMAs ? emaSlow : na, "EMA Slow", color = color.new(color.orange, 0), linewidth = 1)
plot(showEMAs ? vwapValue : na, "VWAP",   color = color.new(color.fuchsia, 0), linewidth = 2)

pUp = plot(showEMAs ? bbUpper : na, "BB Upper", color = color.new(color.gray, 30))
pLo = plot(showEMAs ? bbLower : na, "BB Lower", color = color.new(color.gray, 30))
fill(pUp, pLo, color = showEMAs ? color.new(color.gray, 92) : na, title = "BB fill")

plotshape(buySignal,  title = "Buy",  style = shape.triangleup,   location = location.belowbar,
     color = color.lime, size = size.small, offset = -1)
plotshape(sellSignal, title = "Sell", style = shape.triangledown, location = location.abovebar,
     color = color.red,  size = size.small, offset = -1)

// Trend background (based on closed-bar trend to stay non-repainting)
trendUpBar   = (emaMid > vwapValue)[1]
trendDownBar = (emaMid < vwapValue)[1]
bgcolor(colorTrend ? (trendUpBar ? color.new(color.green, 92) : trendDownBar ? color.new(color.red, 92) : na) : na)

// ------------------------- Alerts ------------------------------------
alertcondition(buySignal,  "VWAP+EMA Buy",  "Buy: EMA9>VWAP & EMA5/20 momentum aligned")
alertcondition(sellSignal, "VWAP+EMA Sell", "Sell: EMA9<VWAP & EMA5/20 momentum aligned")
