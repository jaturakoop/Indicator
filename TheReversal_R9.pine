// © Indicator
//@version=5
// =====================================================================
//  TheReversal_R9 — order-agnostic components + two-stage HTF -> LTF
// ---------------------------------------------------------------------
//  WHAT CHANGED FROM R0-R6 (this is the important one)
//
//  Every earlier revision modelled the setup as an ORDERED state machine:
//     sweep -> iFVG -> CISD -> MSS
//  Real charts do not respect that order. A valid setup can run
//     CISD -> MSS -> sweep -> iFVG
//  (price breaks structure first, then comes back, takes liquidity, and
//  inverts the gap). R6 discarded those setups outright and printed
//  nothing.
//
//  R7 dropped the ordering requirement entirely. A setup is COMPLETE when
//  all five components are simultaneously "fresh" — i.e. each occurred
//  within `windowBars` of now — in ANY order:
//
//     [1] POI touched            price traded into your POI zone
//     [2] CISD broken            close above the CISD level
//     [3] MSS broken             close above the reference swing high
//     [4] Liquidity swept        wick under a prior swing low, close back above
//     [5] FVG inverted (iFVG)    close back above a bearish FVG
//
//  Levels (bullish; bearish mirrored):
//     MSS  = the reference swing high that got broken
//     CISD = open of the first red candle after that swing high
//     iFVG = the bearish FVG that price closed back above
//
//  R9 — FOUR PHASES. Both timeframes work the SAME way: a pattern completes,
//  it publishes E1/E2/E3, and then you wait for price to come BACK to one of
//  those levels. R8 was missing the second retrace and fired the entry as
//  soon as the LTF pattern completed, which was far too early.
//
//     PHASE 1  HTF (e.g. M15): wait for the 5 components to complete
//     PHASE 2  HTF levels published -> wait for price to return to
//              E1/E2/E3        ->  fires the "switch to LTF" alert
//     PHASE 3  LTF (e.g. M1): wait for the 5 components to complete
//     PHASE 4  LTF levels published -> wait for price to return to
//              E1/E2/E3        ->  fires the ENTRY arrow
//
//  Only the ACTIVE phase's pattern is drawn: HTF levels during phase 2, LTF
//  levels during phase 4. Carried over from R8: the POI has a START time
//  (it no longer stretches infinitely left), and HTF/LTF are explicit
//  inputs run through request.security, so the result is identical whatever
//  chart timeframe you happen to be viewing.
//
//  BIAS: a POI below price = long-only; above price = short-only.
//  Non-repainting: both timeframes use lookahead_off, and the HTF latch and
//  the LTF signal both require a closed chart bar.
// =====================================================================
indicator("TheReversal R9", overlay = true, max_bars_back = 1000, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 200)

// ------------------------- Inputs ------------------------------------
grpPOI = "1) POI  (you place it)"
htfTF   = input.timeframe("15", "HTF  (stage 1 runs here)", group = grpPOI)
ltfTF   = input.timeframe("1",  "LTF  (stage 3 / entry runs here)", group = grpPOI)
manTop  = input.price(0.0, "POI TOP    (drag on chart)", confirm = true, group = grpPOI)
manBot  = input.price(0.0, "POI BOTTOM (drag on chart)", confirm = true, group = grpPOI)
// The POI only exists from the candle you anchored it to. Without this the
// zone stretched infinitely left and the engine kept finding old setups
// that had already played out.
poiStart = input.time(timestamp("01 Jan 2000 00:00 +0000"), "POI START  (click the candle)", confirm = true, group = grpPOI)
biasIn  = input.string("Auto (from POI vs price)", "Bias", options = ["Auto (from POI vs price)", "Buy only", "Sell only"], group = grpPOI)
poiTolTicks = input.float(80, "POI touch tolerance (ticks)", minval = 0, group = grpPOI)
poiColor    = input.color(color.new(color.orange, 82), "POI zone colour", group = grpPOI)

grpEng = "2) Component detection (used on BOTH timeframes)"
structLen  = input.int(5,  "Swing pivot length (MSS / CISD reference)", minval = 2, maxval = 50, group = grpEng)
sweepLen   = input.int(5,  "Liquidity pivot length (sweep target)", minval = 1, maxval = 50, group = grpEng)
legLook    = input.int(40, "Scan depth for the CISD candle (bars)", minval = 4, maxval = 300, group = grpEng)
windowBars = input.int(80, "All components must occur within (bars)", minval = 5, maxval = 500, group = grpEng)
needPOI    = input.bool(true,  "Require the POI touch as a component", group = grpEng)
needSweep  = input.bool(true,  "Require the liquidity sweep", group = grpEng)
needCISD   = input.bool(true,  "Require the CISD break", group = grpEng)
needMSS    = input.bool(true,  "Require the MSS break", group = grpEng)
needIFVG   = input.bool(true,  "Require the FVG inversion (iFVG)", group = grpEng)

grpLink = "3) Phase hand-off"
setupTTL   = input.int(400, "Each phase expires after (chart bars)", minval = 10, maxval = 5000, group = grpLink)
entryTolTicks = input.float(40, "Entry-level touch tolerance (ticks)", minval = 0, group = grpLink)

grpDraw = "4) Drawing"
drawZones   = input.bool(true, "Draw POI / iFVG zones", group = grpDraw)
drawLevels  = input.bool(true, "Draw E1 / E2 / E3 + LTF levels", group = grpDraw)
showSL      = input.bool(true, "Draw SL lines", group = grpDraw)
levelExtend = input.int(30, "Extend lines/zones (bars)", minval = 1, maxval = 400, group = grpDraw)

grpDash = "5) Dashboard"
showDash = input.bool(true, "Show dashboard", group = grpDash)
dashPos  = input.string("Right", "Position", options = ["Right", "Left"], group = grpDash)
dashSize = input.string("Normal", "Text size", options = ["Small", "Normal", "Large"], group = grpDash)

tol  = poiTolTicks   * syminfo.mintick
etol = entryTolTicks * syminfo.mintick

// component bit flags (packed into one int so the engine can return them)
F_POI  = 1
F_CISD = 2
F_MSS  = 4
F_SWP  = 8
F_IFVG = 16

// ============ CISD helper: first red/green candle after a pivot =======
// `hOff` = how many bars back the pivot sits. `off` is a BACKWARD offset,
// so the largest qualifying `off` is the bar closest to the pivot, i.e.
// the FIRST candle after it. The ascending loop overwrites -> last wins.
firstRedOpenAfter(int hOff) =>
    float c = na
    for off = 0 to legLook
        if off < hOff and close[off] < open[off]
            c := open[off]
    c
firstGreenOpenAfter(int hOff) =>
    float c = na
    for off = 0 to legLook
        if off < hOff and close[off] > open[off]
            c := open[off]
    c

// ===================== THE SHARED ENGINE =============================
// Order-agnostic component tracker. Called at four sites (bull/bear x
// HTF/LTF), each through request.security; every call site keeps its own
// `var` state, so the runs never interfere.
// Returns: cnt, mask, mss, cisd, ifvgTop, ifvgBot, slSafe, slAggr
bullEngine(float poiTop, float poiBot, int poiFrom) =>
    var int   poiBar = na
    var float liqLow = na
    var int   swpBar = na
    var float swpLow = na
    var float swpLiq = na
    var float refHigh = na        // reference swing high (not yet broken)
    var float refCisd = na        // its CISD level
    var bool  cisdTaken = false   // break already recorded for this reference
    var bool  mssTaken = false
    var int   cisdBar = na
    var float cisdLvl = na
    var int   mssBar = na
    var float mssLvl = na
    var float pFvgTop = na        // pending (not yet inverted) bearish FVG
    var float pFvgBot = na
    var int   ifvgBar = na
    var float ifvgTop = na
    var float ifvgBot = na
    var bool  wasComplete = false
    var int   cnt = 0
    var float oMss = na
    var float oCisd = na
    var float oIft = na
    var float oIfb = na
    var float oSlS = na
    var float oSlA = na

    // ta.* must run every bar, never inside an if
    ph = ta.pivothigh(high, structLen, structLen)
    pl = ta.pivotlow(low, sweepLen, sweepLen)
    poiChanged = ta.change(nz(poiTop, -1.0))

    // a new POI (next HTF band) must not inherit the previous latches
    if poiChanged != 0
        poiBar := na
        swpBar := na
        cisdBar := na
        mssBar := na
        ifvgBar := na
        wasComplete := false

    // [1] POI touch
    if not na(poiTop) and time >= poiFrom and low <= poiTop + tol and high >= poiBot - tol
        poiBar := bar_index

    // reference swing high + its CISD level, refreshed on every new pivot
    if not na(ph)
        refHigh := ph
        refCisd := firstRedOpenAfter(structLen)
        cisdTaken := false
        mssTaken := false

    // [2] CISD break / [3] MSS break — may happen BEFORE or AFTER the sweep.
    // Recorded on the BREAK bar only (`*Taken`), otherwise the component
    // would re-stamp itself every bar price stays above the level and the
    // `windowBars` freshness test would mean nothing.
    if not cisdTaken and not na(refCisd) and close > refCisd
        cisdBar := bar_index
        cisdLvl := refCisd
        cisdTaken := true
    if not mssTaken and not na(refHigh) and close > refHigh
        mssBar := bar_index
        mssLvl := refHigh
        mssTaken := true

    // [4] liquidity sweep of a prior swing low
    if not na(pl)
        liqLow := pl
    if not na(liqLow) and low < liqLow and close > liqLow
        swpBar := bar_index
        swpLow := low
        swpLiq := liqLow

    // [5] bearish FVG -> inverted (iFVG) when a close reclaims it
    if high < low[2]
        pFvgTop := low[2]
        pFvgBot := high
    if not na(pFvgTop) and close > pFvgTop
        ifvgBar := bar_index
        ifvgTop := pFvgTop
        ifvgBot := pFvgBot
        pFvgTop := na
        pFvgBot := na

    // ---- completeness: every REQUIRED component fresh within the window
    // na(poiTop) = this run has no POI of its own (the LTF run). The POI
    // component is then "not applicable" and the chart-level phase machine
    // is what constrains where the pattern may occur.
    okPoi  = not needPOI or na(poiTop) or (not na(poiBar) and bar_index - poiBar <= windowBars)
    okCisd = not needCISD  or (not na(cisdBar) and bar_index - cisdBar <= windowBars)
    okMss  = not needMSS   or (not na(mssBar)  and bar_index - mssBar  <= windowBars)
    okSwp  = not needSweep or (not na(swpBar)  and bar_index - swpBar  <= windowBars)
    okIfvg = not needIFVG  or (not na(ifvgBar) and bar_index - ifvgBar <= windowBars)
    complete = okPoi and okCisd and okMss and okSwp and okIfvg

    mask = (okPoi ? F_POI : 0) + (okCisd ? F_CISD : 0) + (okMss ? F_MSS : 0) + (okSwp ? F_SWP : 0) + (okIfvg ? F_IFVG : 0)

    // fire on the rising edge of completeness
    if complete and not wasComplete
        cnt := cnt + 1
        oMss := mssLvl
        oCisd := cisdLvl
        oIft := ifvgTop
        oIfb := ifvgBot
        oSlS := nz(swpLow, ifvgBot)
        oSlA := nz(swpLiq, nz(swpLow, ifvgBot))
    wasComplete := complete

    [cnt, mask, oMss, oCisd, oIft, oIfb, oSlS, oSlA]

bearEngine(float poiTop, float poiBot, int poiFrom) =>
    var int   poiBar = na
    var float liqHigh = na
    var int   swpBar = na
    var float swpHigh = na
    var float swpLiq = na
    var float refLow = na
    var float refCisd = na
    var bool  cisdTaken = false
    var bool  mssTaken = false
    var int   cisdBar = na
    var float cisdLvl = na
    var int   mssBar = na
    var float mssLvl = na
    var float pFvgTop = na
    var float pFvgBot = na
    var int   ifvgBar = na
    var float ifvgTop = na
    var float ifvgBot = na
    var bool  wasComplete = false
    var int   cnt = 0
    var float oMss = na
    var float oCisd = na
    var float oIft = na
    var float oIfb = na
    var float oSlS = na
    var float oSlA = na

    pl2 = ta.pivotlow(low, structLen, structLen)
    ph2 = ta.pivothigh(high, sweepLen, sweepLen)
    poiChanged = ta.change(nz(poiTop, -1.0))

    if poiChanged != 0
        poiBar := na
        swpBar := na
        cisdBar := na
        mssBar := na
        ifvgBar := na
        wasComplete := false

    if not na(poiTop) and time >= poiFrom and high >= poiBot - tol and low <= poiTop + tol
        poiBar := bar_index

    if not na(pl2)
        refLow := pl2
        refCisd := firstGreenOpenAfter(structLen)
        cisdTaken := false
        mssTaken := false

    // recorded on the break bar only — see bullEngine
    if not cisdTaken and not na(refCisd) and close < refCisd
        cisdBar := bar_index
        cisdLvl := refCisd
        cisdTaken := true
    if not mssTaken and not na(refLow) and close < refLow
        mssBar := bar_index
        mssLvl := refLow
        mssTaken := true

    if not na(ph2)
        liqHigh := ph2
    if not na(liqHigh) and high > liqHigh and close < liqHigh
        swpBar := bar_index
        swpHigh := high
        swpLiq := liqHigh

    if low > high[2]
        pFvgTop := low
        pFvgBot := high[2]
    if not na(pFvgBot) and close < pFvgBot
        ifvgBar := bar_index
        ifvgTop := pFvgTop
        ifvgBot := pFvgBot
        pFvgTop := na
        pFvgBot := na

    // na(poiTop) = this run has no POI of its own (the LTF run). The POI
    // component is then "not applicable" and the chart-level phase machine
    // is what constrains where the pattern may occur.
    okPoi  = not needPOI or na(poiTop) or (not na(poiBar) and bar_index - poiBar <= windowBars)
    okCisd = not needCISD  or (not na(cisdBar) and bar_index - cisdBar <= windowBars)
    okMss  = not needMSS   or (not na(mssBar)  and bar_index - mssBar  <= windowBars)
    okSwp  = not needSweep or (not na(swpBar)  and bar_index - swpBar  <= windowBars)
    okIfvg = not needIFVG  or (not na(ifvgBar) and bar_index - ifvgBar <= windowBars)
    complete = okPoi and okCisd and okMss and okSwp and okIfvg

    mask = (okPoi ? F_POI : 0) + (okCisd ? F_CISD : 0) + (okMss ? F_MSS : 0) + (okSwp ? F_SWP : 0) + (okIfvg ? F_IFVG : 0)

    if complete and not wasComplete
        cnt := cnt + 1
        oMss := mssLvl
        oCisd := cisdLvl
        oIft := ifvgTop
        oIfb := ifvgBot
        oSlS := nz(swpHigh, ifvgTop)
        oSlA := nz(swpLiq, nz(swpHigh, ifvgTop))
    wasComplete := complete

    [cnt, mask, oMss, oCisd, oIft, oIfb, oSlS, oSlA]

// ===================== BIAS from POI placement =======================
manValid = manTop > 0 and manBot > 0 and manTop > manBot
var int biasLatch = 0
if biasLatch == 0 and manValid and barstate.isconfirmed
    biasLatch := close > manTop ? 1 : close < manBot ? -1 : 0
isBull = biasIn == "Buy only" ? true : biasIn == "Sell only" ? false : biasLatch >= 0
isBear = biasIn == "Sell only" ? true : biasIn == "Buy only" ? false : biasLatch < 0
biasKnown = biasIn != "Auto (from POI vs price)" or biasLatch != 0

// ===================== STAGE 1 — HTF components ======================
htfPoiTop = manValid ? manTop : na
htfPoiBot = manValid ? manBot : na

[hbCnt, hbMask, hbMss, hbCisd, hbIft, hbIfb, hbSlS, hbSlA] = request.security(syminfo.tickerid, htfTF, bullEngine(htfPoiTop, htfPoiBot, poiStart), lookahead = barmerge.lookahead_off)
[hsCnt, hsMask, hsMss, hsCisd, hsIft, hsIfb, hsSlS, hsSlA] = request.security(syminfo.tickerid, htfTF, bearEngine(htfPoiTop, htfPoiBot, poiStart), lookahead = barmerge.lookahead_off)

htfCnt  = isBull ? hbCnt  : isBear ? hsCnt  : 0
htfMask = isBull ? hbMask : isBear ? hsMask : 0
htfMss  = isBull ? hbMss  : hsMss
htfCisd = isBull ? hbCisd : hsCisd
htfIft  = isBull ? hbIft  : hsIft
htfIfb  = isBull ? hbIfb  : hsIfb

// ===================== LTF components (independent) ==================
// The LTF run has NO POI of its own — it is passed `na`, so its POI
// component is "not applicable" and the phase machine below decides WHEN an
// LTF pattern counts. This also keeps every request.security argument a
// plain input/constant: feeding a chart-derived series into a security
// expression (as R5-R8 did) creates a circular context dependency.
[lbCnt, lbMask, lbMss, lbCisd, lbIft, lbIfb, lbSlS, lbSlA] = request.security(syminfo.tickerid, ltfTF, bullEngine(na, na, poiStart), lookahead = barmerge.lookahead_off)
[lsCnt, lsMask, lsMss, lsCisd, lsIft, lsIfb, lsSlS, lsSlA] = request.security(syminfo.tickerid, ltfTF, bearEngine(na, na, poiStart), lookahead = barmerge.lookahead_off)

ltfCnt  = isBull ? lbCnt  : isBear ? lsCnt  : 0
ltfMask = isBull ? lbMask : isBear ? lsMask : 0
ltfMss  = isBull ? lbMss  : lsMss
ltfCisd = isBull ? lbCisd : lsCisd
ltfIft  = isBull ? lbIft  : lsIft
ltfIfb  = isBull ? lbIfb  : lsIfb
ltfSlS  = isBull ? lbSlS  : lsSlS
ltfSlA  = isBull ? lbSlA  : lsSlA

// ===================== THE 4-PHASE MACHINE ===========================
//  P1  waiting for the HTF pattern to complete
//  P2  HTF complete -> its E1/E2/E3 are live, waiting for price to return
//      to one of them            -> fires the "switch to LTF" alert
//  P3  waiting for the LTF pattern to complete
//  P4  LTF complete -> its E1/E2/E3 are live, waiting for price to return
//      to one of them            -> fires the ENTRY arrow
P1 = 1
P2 = 2
P3 = 3
P4 = 4

var int   phase = P1
var int   phaseBar = na
var int   dir = 0
// HTF published levels
var float e1 = na
var float e2 = na
var float e3t = na
var float e3b = na
// LTF published levels
var float f1 = na
var float f2 = na
var float f3t = na
var float f3b = na
var float fSlS = na
var float fSlA = na

htfChg = ta.change(htfCnt)
ltfChg = ta.change(ltfCnt)

// touch tests against a level / a zone
touchLvl(float lv) => not na(lv) and low <= lv + etol and high >= lv - etol
touchZone(float a, float b) => not na(a) and not na(b) and low <= math.max(a, b) + etol and high >= math.min(a, b) - etol

hitHtf = phase == P2 and (touchLvl(e1) or touchLvl(e2) or touchZone(e3t, e3b))
hitLtf = phase == P4 and (touchLvl(f1) or touchLvl(f2) or touchZone(f3t, f3b))
whichHtf = not hitHtf ? 0 : touchZone(e3t, e3b) ? 3 : touchLvl(e2) ? 2 : 1
whichLtf = not hitLtf ? 0 : touchZone(f3t, f3b) ? 3 : touchLvl(f2) ? 2 : 1

switchAlert = false
entrySignal = false
var int   entryDir = 0
var int   entryBar = na
var int   entryTime = na
var int   entryWhich = 0

if barstate.isconfirmed and biasKnown
    // ---- P2/P3/P4 expiry -> fall back to hunting a new HTF setup ----
    if phase != P1 and not na(phaseBar) and bar_index - phaseBar > setupTTL
        phase := P1
        dir := 0

    // ---- P1 -> P2 : the HTF pattern completed --------------------
    if phase == P1 and htfChg != 0 and not na(htfMss) and not na(htfIft)
        e1 := htfMss
        e2 := htfCisd
        e3t := htfIft
        e3b := htfIfb
        dir := isBull ? 1 : -1
        phase := P2
        phaseBar := bar_index

    // ---- P2 -> P3 : price came back to an HTF level ---------------
    else if hitHtf
        switchAlert := true
        phase := P3
        phaseBar := bar_index

    // ---- P3 -> P4 : the LTF pattern completed ---------------------
    else if phase == P3 and ltfChg != 0 and not na(ltfMss) and not na(ltfIft)
        f1 := ltfMss
        f2 := ltfCisd
        f3t := ltfIft
        f3b := ltfIfb
        fSlS := ltfSlS
        fSlA := ltfSlA
        phase := P4
        phaseBar := bar_index

    // ---- P4 -> entry : price came back to an LTF level ------------
    else if hitLtf
        entrySignal := true
        entryDir := dir
        entryBar := bar_index
        entryTime := time
        entryWhich := whichLtf
        phase := P1
        dir := 0

buySignal  = entrySignal and entryDir ==  1
sellSignal = entrySignal and entryDir == -1

// what the dashboard/drawing should show right now
showHtf = phase == P2
showLtf = phase == P4
entryHit = phase == P2 ? whichHtf : phase == P4 ? whichLtf : 0

// levels of the fired entry, kept for drawing / dashboard
var int   lastDir = 0
var int   lastSigBar = na
var int   lastSigTime = na
var float sMssL = na
var float sCisdL = na
var float sIftL = na
var float sIfbL = na
var float sSlS = na
var float sSlA = na
if entrySignal
    lastDir := entryDir
    lastSigBar := entryBar
    lastSigTime := entryTime
    sMssL  := f1
    sCisdL := f2
    sIftL  := f3t
    sIfbL  := f3b
    sSlS   := fSlS
    sSlA   := fSlA

// ========================= DRAWING ===================================
f_size() => dashSize == "Small" ? size.small : dashSize == "Large" ? size.large : size.normal

if buySignal or sellSignal
    xr = bar_index + levelExtend
    if drawLevels and not na(sMssL)
        line.new(bar_index, sMssL, xr, sMssL, color = color.new(color.blue, 0), width = 2)
        label.new(xr, sMssL, " LTF MSS", style = label.style_none, textcolor = color.blue, size = size.small)
    if drawLevels and not na(sCisdL)
        line.new(bar_index, sCisdL, xr, sCisdL, color = color.new(color.purple, 0), width = 2)
        label.new(xr, sCisdL, " LTF CISD", style = label.style_none, textcolor = color.purple, size = size.small)
    if drawZones and not na(sIftL)
        box.new(bar_index, math.max(sIftL, sIfbL), xr, math.min(sIftL, sIfbL), border_color = color.new(color.aqua, 40), bgcolor = color.new(color.aqua, 82))
    if showSL and not na(sSlS)
        line.new(bar_index, sSlS, xr, sSlS, color = color.new(color.red, 10), style = line.style_dashed)
        label.new(xr, sSlS, " SL safety", style = label.style_none, textcolor = color.red, size = size.small)
    if showSL and not na(sSlA)
        line.new(bar_index, sSlA, xr, sSlA, color = color.new(color.orange, 10), style = line.style_dotted)
        label.new(xr, sSlA, " SL aggr.", style = label.style_none, textcolor = color.orange, size = size.small)

var box poiBox = na
var box bandBox = na
var line[]  liveLn = array.new_line()
var label[] liveLb = array.new_label()
pushLive(int x1, float p, string txt, color c, string st) =>
    xr = bar_index + levelExtend
    ls = st == "solid" ? line.style_solid : st == "dashed" ? line.style_dashed : line.style_dotted
    array.push(liveLn, line.new(x1, p, xr, p, color = c, style = ls))
    array.push(liveLb, label.new(xr, p, txt, style = label.style_none, textcolor = c, size = size.small))

if barstate.islast
    if not na(poiBox)
        box.delete(poiBox)
    if not na(bandBox)
        box.delete(bandBox)
    // POI box anchored to its START time (xloc.bar_time) so it begins at the
    // candle you picked instead of running off to the left edge.
    if drawZones and manValid
        poiRight = time + levelExtend * timeframe.in_seconds() * 1000
        poiBox := box.new(poiStart, manTop, poiRight, manBot, xloc = xloc.bar_time, border_color = color.new(color.orange, 40), bgcolor = poiColor, text = "POI " + htfTF + (not biasKnown ? "  (bias ?)" : isBull ? "  (bias BUY)" : "  (bias SELL)"), text_color = color.new(color.orange, 0), text_halign = text.align_left, text_size = size.small)
    // iFVG zone of whichever phase is currently live
    if drawZones and showHtf and not na(e3t)
        bandBox := box.new(math.max(0, nz(phaseBar, bar_index)), math.max(e3t, e3b), bar_index + levelExtend, math.min(e3t, e3b), border_color = color.new(color.blue, 50), bgcolor = color.new(color.blue, 90), text = "HTF iFVG", text_color = color.new(color.blue, 0), text_halign = text.align_right, text_size = size.small)
    if drawZones and showLtf and not na(f3t)
        bandBox := box.new(math.max(0, nz(phaseBar, bar_index)), math.max(f3t, f3b), bar_index + levelExtend, math.min(f3t, f3b), border_color = color.new(color.aqua, 40), bgcolor = color.new(color.aqua, 85), text = "LTF iFVG", text_color = color.new(color.teal, 0), text_halign = text.align_right, text_size = size.small)
    while array.size(liveLn) > 0
        line.delete(array.pop(liveLn))
    while array.size(liveLb) > 0
        label.delete(array.pop(liveLb))
    x0 = math.max(0, nz(phaseBar, bar_index))
    // Only the ACTIVE phase's pattern is shown: HTF levels while waiting for
    // the retrace on the HTF, LTF levels once the LTF pattern has completed.
    if drawLevels and showHtf
        pushLive(x0, e1,  " HTF E1 · MSS",      color.blue,   "solid")
        pushLive(x0, e2,  " HTF E2 · CISD",     color.purple, "dotted")
        pushLive(x0, e3t, " HTF E3 · iFVG top", color.teal,   "dotted")
        pushLive(x0, e3b, " HTF E3 · iFVG bot", color.teal,   "dotted")
    if drawLevels and showLtf
        pushLive(x0, f1,  " LTF E1 · MSS",      color.blue,   "solid")
        pushLive(x0, f2,  " LTF E2 · CISD",     color.purple, "dotted")
        pushLive(x0, f3t, " LTF E3 · iFVG top", color.teal,   "dotted")
        pushLive(x0, f3b, " LTF E3 · iFVG bot", color.teal,   "dotted")

plotshape(buySignal,  title = "Buy",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.lime, 0), size = size.normal, text = "BUY")
plotshape(sellSignal, title = "Sell", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),  size = size.normal, text = "SELL")

// ========================= DASHBOARD =================================
dot(bool on)  => on ? "●" : "○"
dcol(bool on) => on ? color.new(#26a69a, 0) : color.new(color.gray, 45)
has(int m, int f) => (m / f) % 2 >= 1

var table dash = na
if showDash and barstate.islast
    ts  = f_size()
    pos = dashPos == "Left" ? position.top_left : position.top_right
    tk  = format.mintick
    dirTxt = not biasKnown ? "? in POI" : isBull ? "BUY ▲" : "SELL ▼"
    dirCol = not biasKnown ? color.gray : isBull ? color.lime : color.red

    if na(dash)
        dash := table.new(pos, 3, 15, border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
    table.cell(dash, 0, 0, "🎯 TheReversal R9", text_color = color.white, text_size = ts, bgcolor = color.new(#1f2937, 0))
    table.cell(dash, 1, 0, "HTF " + htfTF, text_color = color.new(color.silver, 0), text_size = ts, bgcolor = color.new(#1f2937, 0))
    table.cell(dash, 2, 0, "LTF " + ltfTF, text_color = color.new(color.silver, 0), text_size = ts, bgcolor = color.new(#1f2937, 0))

    table.cell(dash, 0, 1, "bias", text_color = color.silver, text_size = ts)
    table.cell(dash, 1, 1, dirTxt, text_color = dirCol, text_size = ts)
    table.cell(dash, 2, 1, "chart " + timeframe.period, text_color = color.silver, text_size = ts)

    // components — order does NOT matter, only that all are fresh
    labs = array.from("POI touched", "CISD broken", "MSS broken", "Liquidity swept", "iFVG formed")
    flags = array.from(F_POI, F_CISD, F_MSS, F_SWP, F_IFVG)
    for r = 0 to 4
        f = array.get(flags, r)
        hOn = has(htfMask, f)
        lOn = has(ltfMask, f)
        table.cell(dash, 0, r + 2, array.get(labs, r), text_color = color.silver, text_size = ts)
        table.cell(dash, 1, r + 2, dot(hOn), text_color = dcol(hOn), text_size = ts)
        table.cell(dash, 2, r + 2, dot(lOn), text_color = dcol(lOn), text_size = ts)

    // ---- current phase ------------------------------------------------
    phTxt = phase == P1 ? "1 · wait HTF pattern" : phase == P2 ? "2 · wait HTF retrace" : phase == P3 ? "3 · wait LTF pattern" : "4 · wait LTF retrace"
    phCol = phase == P1 ? color.silver : phase == P2 ? color.orange : phase == P3 ? color.aqua : color.yellow
    table.cell(dash, 0, 7, "PHASE", text_color = color.silver, text_size = ts, bgcolor = color.new(#1f2937, 30))
    table.cell(dash, 1, 7, phTxt, text_color = phCol, text_size = ts, bgcolor = color.new(#1f2937, 30))
    table.cell(dash, 2, 7, phase == P3 ? "▶ go " + ltfTF : entryHit > 0 ? "at E" + str.tostring(entryHit) : "-", text_color = phase == P3 ? color.aqua : entryHit > 0 ? color.yellow : color.silver, text_size = ts, bgcolor = color.new(#1f2937, 30))

    // ---- levels of whichever phase is live -----------------------------
    lvTag = showLtf ? "LTF " : "HTF "
    v1 = showLtf ? f1 : e1
    v2 = showLtf ? f2 : e2
    v3t = showLtf ? f3t : e3t
    v3b = showLtf ? f3b : e3b
    liveLv = showHtf or showLtf
    table.cell(dash, 0, 8, lvTag + "E1 · MSS", text_color = color.new(color.blue, 0), text_size = ts)
    table.cell(dash, 1, 8, liveLv ? str.tostring(v1, tk) : "-", text_color = color.silver, text_size = ts)
    table.cell(dash, 2, 8, entryHit == 1 ? "◀" : "", text_color = color.yellow, text_size = ts)
    table.cell(dash, 0, 9, lvTag + "E2 · CISD", text_color = color.new(color.purple, 0), text_size = ts)
    table.cell(dash, 1, 9, liveLv ? str.tostring(v2, tk) : "-", text_color = color.silver, text_size = ts)
    table.cell(dash, 2, 9, entryHit == 2 ? "◀" : "", text_color = color.yellow, text_size = ts)
    table.cell(dash, 0, 10, lvTag + "E3 · iFVG", text_color = color.new(color.teal, 0), text_size = ts)
    table.cell(dash, 1, 10, liveLv ? str.tostring(v3t, tk) + "–" + str.tostring(v3b, tk) : "-", text_color = color.silver, text_size = ts)
    table.cell(dash, 2, 10, entryHit == 3 ? "◀" : "", text_color = color.yellow, text_size = ts)

    haveSig = not na(lastSigBar)
    table.cell(dash, 0, 11, "SIGNAL", text_color = color.silver, text_size = ts, bgcolor = color.new(#1f2937, 30))
    table.cell(dash, 1, 11, haveSig ? (lastDir == 1 ? "BUY ▲" : "SELL ▼") : "-", text_color = not haveSig ? color.gray : lastDir == 1 ? color.lime : color.red, text_size = ts, bgcolor = color.new(#1f2937, 30))
    table.cell(dash, 2, 11, haveSig ? str.format_time(lastSigTime, "HH:mm", syminfo.timezone) : "-", text_color = color.silver, text_size = ts, bgcolor = color.new(#1f2937, 30))
    table.cell(dash, 0, 12, "SL safety", text_color = color.new(color.red, 0), text_size = ts)
    table.cell(dash, 1, 12, haveSig ? str.tostring(sSlS, tk) : "-", text_color = color.silver, text_size = ts)
    table.cell(dash, 2, 12, "", text_color = color.silver, text_size = ts)
    table.cell(dash, 0, 13, "SL aggressive", text_color = color.new(color.orange, 0), text_size = ts)
    table.cell(dash, 1, 13, haveSig ? str.tostring(sSlA, tk) : "-", text_color = color.silver, text_size = ts)
    table.cell(dash, 2, 13, "", text_color = color.silver, text_size = ts)
    table.cell(dash, 0, 14, "window", text_color = color.silver, text_size = ts)
    table.cell(dash, 1, 14, str.tostring(windowBars) + " bars", text_color = color.silver, text_size = ts)
    table.cell(dash, 2, 14, "", text_color = color.silver, text_size = ts)

// ------------------------- Alerts ------------------------------------
// Phase 2 -> 3: the HTF pattern is done and price has returned to one of its
// levels. This is your cue to drop to the LTF and watch for pattern #2.
alertcondition(switchAlert, "TheReversal R9 · switch to LTF", "HTF pattern complete and price is at an HTF entry level — switch to the LTF")
alertcondition(buySignal,  "TheReversal R9 Buy",  "BUY: HTF pattern -> retrace -> LTF pattern -> retrace to LTF entry")
alertcondition(sellSignal, "TheReversal R9 Sell", "SELL: HTF pattern -> retrace -> LTF pattern -> retrace to LTF entry")
