// © Indicator
//@version=5
// =====================================================================
//  TheReversal_R4 — POI + Sweep + iFVG + CISD + MSS  (TradingView)
// ---------------------------------------------------------------------
//  R4 = R3 + independent-audit fixes. What changed and why:
//
//  [FIX-1] ORIGIN HIGH (the big one).  R3 used "the most recent pivot
//          high", so every lower high formed during the drop overwrote
//          it -> MSS anchored on a mid-leg lower high and printed too
//          low.  R4 keeps a rolling list of confirmed pivot highs and,
//          AT SWEEP TIME, picks the HIGHEST one within `legLook` bars.
//  [FIX-2] INVALIDATION.  R3 stages only ever ratcheted up, so a setup
//          whose swept low was blown 50 bars ago could still fire.  R4
//          kills a setup when price trades below the swept low, or (once
//          iFVG is reached) closes back under the FVG.
//  [FIX-3] SL LEVELS FROZEN.  R3 read `liqLow` live at signal time, so
//          the "aggressive" SL drifted (often onto the safety SL).  R4
//          freezes it into the setup at sweep time.
//  [FIX-4] POI TOUCH IS LATCHED.  R3 needed the POI touch and the sweep
//          on the SAME bar; R4 remembers the touch for `legLook` bars.
//  [FIX-5] ONE STAGE PER BAR.  R3 could complete all stages on a single
//          news candle.  R4 requires each stage on a strictly later bar.
//  [FIX-6] STACK GUARD relaxed to >= and now also demands `close < ft`
//          at arm time, so the iFVG stage cannot be pre-satisfied.
//  [FIX-7] FVG WINDOW.  `off + 2 <= hAge` so the 3-candle pattern cannot
//          reach back to a candle that predates the origin high.
//  [FIX-8] SWEEP QUALITY.  The sweep bar must be the lowest point since
//          the origin high (a real extreme, not a mid-leg pullback).
//  [FIX-9] max_bars_back + input caps + non-negative box coords, which
//          fixes the "cannot determine the referencing length" runtime
//          error caused by loop-variable history access inside `if`s.
//
//  Engine: POI (manual zone you place) -> sweep of a prior swing low ->
//  close above the bearish FVG (iFVG) -> close above CISD -> close above
//  the origin high (MSS) = BUY arrow + alert.  Bearish is mirrored.
//    MSS  = the origin swing high H
//    CISD = open of the first red candle after H
//    iFVG = the first bearish FVG after H
//  Entries: 1 = MSS · 2 = CISD · 3 = iFVG zone.
//  SL: safety = swept wick · aggressive = the swept swing-low level.
// =====================================================================
indicator("TheReversal R4", overlay = true, max_bars_back = 5000, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 200)

// ------------------------- POI (manual first) ------------------------
grpPOI = "1) POI"
poiMode = input.string("Manual", "POI mode", options = ["Manual", "Auto"], group = grpPOI)
poiDir  = input.string("Both", "Manual POI acts as", options = ["Buy (support)", "Sell (resistance)", "Both"], group = grpPOI)
manTop  = input.price(0.0, "Manual POI — TOP    (drag on chart)", confirm = true, group = grpPOI)
manBot  = input.price(0.0, "Manual POI — BOTTOM (drag on chart)", confirm = true, group = grpPOI)
poiTolTicks = input.float(80, "POI touch tolerance (ticks)", minval = 0, group = grpPOI)
poiColor    = input.color(color.new(color.orange, 80), "POI zone colour", group = grpPOI)

grpAuto = "1b) POI — Auto mode settings"
poiTF        = input.timeframe("15", "Auto POI timeframe", group = grpAuto)
poiType      = input.string("OB", "Auto POI type", options = ["OB", "Swing", "FVG", "Fibo"], group = grpAuto)
poiZoneTicks = input.float(80, "Auto zone thickness Swing (ticks)", minval = 0, group = grpAuto)
fibA         = input.float(0.5,   "Fibo near edge", group = grpAuto)
fibB         = input.float(0.786, "Fibo far edge",  group = grpAuto)

grpEng = "2) Sequence engine (entry TF)"
structLen = input.int(5, "Structure pivot length (origin high/low)", minval = 2, maxval = 50, group = grpEng)
sweepLen  = input.int(5, "Liquidity pivot length (sweep target)", minval = 1, maxval = 50, group = grpEng)
legLook   = input.int(40, "Max leg length H→sweep (bars)", minval = 4, maxval = 300, group = grpEng)
maxBars   = input.int(60, "Max bars from sweep to MSS", minval = 1, maxval = 500, group = grpEng)
strictSeq = input.bool(true, "One stage per bar (no same-bar cascade)", group = grpEng)
needLegLow = input.bool(true, "Sweep must be the lowest point since H", group = grpEng)

grpDraw = "3) Levels & entries"
drawZones   = input.bool(true, "Draw POI + iFVG zones", group = grpDraw)
drawLevels  = input.bool(true, "Draw CISD / MSS / Entry / SL lines", group = grpDraw)
showSL      = input.bool(true, "Draw SL lines", group = grpDraw)
levelExtend = input.int(25, "Extend lines/zones (bars)", minval = 1, maxval = 400, group = grpDraw)

grpDash = "4) Dashboard"
showDash = input.bool(true, "Show dashboard", group = grpDash)
dashPos  = input.string("Right", "Position", options = ["Right", "Left"], group = grpDash)
dashSize = input.string("Normal", "Text size", options = ["Small", "Normal", "Large"], group = grpDash)

// ------------------------- Constants ---------------------------------
ST_IDLE  = 0
ST_SWEPT = 1
ST_IFVG  = 2
ST_CISD  = 3

tol = poiTolTicks * syminfo.mintick
zh  = poiZoneTicks * syminfo.mintick

// ================= MODULE 1 — Auto POI zone (HTF context) ============
poiZoneCalc() =>
    var float sT = na
    var float sB = na
    var float rT = na
    var float rB = na
    var float prevLo = na
    var float prevHi = na
    ph = ta.pivothigh(high, structLen, structLen)
    pl = ta.pivotlow(low, structLen, structLen)
    pHi = high[structLen]
    pLo = low[structLen]
    if not na(pl)
        if poiType == "Swing"
            sB := pLo
            sT := pLo + zh
        else if poiType == "OB"
            sT := pHi
            sB := pLo
        else if poiType == "FVG"
            if low[structLen-1] > high[structLen+1]
                sT := low[structLen-1]
                sB := high[structLen+1]
            else
                sB := pLo
                sT := pLo + zh
        else if poiType == "Fibo" and not na(prevHi) and prevHi > pLo
            sT := prevHi - fibA * (prevHi - pLo)
            sB := prevHi - fibB * (prevHi - pLo)
        prevLo := pLo
    if not na(ph)
        if poiType == "Swing"
            rT := pHi
            rB := pHi - zh
        else if poiType == "OB"
            rT := pHi
            rB := pLo
        else if poiType == "FVG"
            if high[structLen-1] < low[structLen+1]
                rT := low[structLen+1]
                rB := high[structLen-1]
            else
                rT := pHi
                rB := pHi - zh
        else if poiType == "Fibo" and not na(prevLo) and pHi > prevLo
            rB := prevLo + fibA * (pHi - prevLo)
            rT := prevLo + fibB * (pHi - prevLo)
        prevHi := pHi
    [sT, sB, rT, rB]

[aSupTop, aSupBot, aResTop, aResBot] = request.security(syminfo.tickerid, poiTF, poiZoneCalc(), lookahead = barmerge.lookahead_off)

// ---- Resolve the ACTIVE support (bull) / resistance (bear) zones ----
manValid = manTop > 0 and manBot > 0 and manTop > manBot
useManBuy  = poiMode == "Manual" and manValid and (poiDir == "Buy (support)" or poiDir == "Both")
useManSell = poiMode == "Manual" and manValid and (poiDir == "Sell (resistance)" or poiDir == "Both")

supTop = poiMode == "Auto" ? aSupTop : (useManBuy  ? manTop : na)
supBot = poiMode == "Auto" ? aSupBot : (useManBuy  ? manBot : na)
resTop = poiMode == "Auto" ? aResTop : (useManSell ? manTop : na)
resBot = poiMode == "Auto" ? aResBot : (useManSell ? manBot : na)

// ===== MODULE 5/6 — leg scanners (scalar returns; no tuples in ifs) ==
// `off` is a BACKWARD offset, so the largest qualifying `off` is the bar
// closest to the origin high H -> "first candle after H". The ascending
// loop overwrites, so the last write (largest off) wins. [FIX-7] keeps
// the whole 3-candle FVG pattern inside the post-H window.
firstRedOpenAfter(int hAge) =>
    float c = na
    for off = 0 to legLook
        if off < hAge and close[off] < open[off]
            c := open[off]
    c
firstGreenOpenAfter(int hAge) =>
    float c = na
    for off = 0 to legLook
        if off < hAge and close[off] > open[off]
            c := open[off]
    c
bearFvgTopAfter(int hAge) =>
    float t = na
    for off = 0 to legLook
        if off + 2 <= hAge and high[off] < low[off + 2]
            t := low[off + 2]
    t
bearFvgBotAfter(int hAge) =>
    float b = na
    for off = 0 to legLook
        if off + 2 <= hAge and high[off] < low[off + 2]
            b := high[off]
    b
bullFvgTopAfter(int hAge) =>
    float t = na
    for off = 0 to legLook
        if off + 2 <= hAge and low[off] > high[off + 2]
            t := low[off]
    t
bullFvgBotAfter(int hAge) =>
    float b = na
    for off = 0 to legLook
        if off + 2 <= hAge and low[off] > high[off + 2]
            b := high[off + 2]
    b
// [FIX-8] the sweep bar must be the extreme of the leg since H
isLegLow(int hAge) =>
    bool ok = true
    for off = 1 to legLook
        if off < hAge and low[off] < low
            ok := false
    ok
isLegHigh(int hAge) =>
    bool ok = true
    for off = 1 to legLook
        if off < hAge and high[off] > high
            ok := false
    ok

// ------------------------- Pivot bookkeeping -------------------------
phS = ta.pivothigh(high, structLen, structLen)
plS = ta.pivotlow(low,  structLen, structLen)
plL = ta.pivotlow(low,  sweepLen,  sweepLen)
phL = ta.pivothigh(high, sweepLen,  sweepLen)

// [FIX-1] rolling history of confirmed structure pivots
var float[] phVal = array.new_float()
var int[]   phBar = array.new_int()
var float[] plVal = array.new_float()
var int[]   plBar = array.new_int()

var float liqLow  = na
var int   liqLowBar = na
var float liqHigh = na
var int   liqHighBar = na

// [FIX-1] highest confirmed pivot high within `legLook` (value / bar)
originHighVal() =>
    float best = na
    n = array.size(phVal)
    if n > 0
        for i = 1 to n
            idx = n - i
            b = array.get(phBar, idx)
            if bar_index - b <= legLook
                v = array.get(phVal, idx)
                if na(best) or v > best
                    best := v
    best
originHighBar() =>
    float best = na
    int bestBar = na
    n = array.size(phBar)
    if n > 0
        for i = 1 to n
            idx = n - i
            b = array.get(phBar, idx)
            if bar_index - b <= legLook
                v = array.get(phVal, idx)
                if na(best) or v > best
                    best := v
                    bestBar := b
    bestBar
originLowVal() =>
    float best = na
    n = array.size(plVal)
    if n > 0
        for i = 1 to n
            idx = n - i
            b = array.get(plBar, idx)
            if bar_index - b <= legLook
                v = array.get(plVal, idx)
                if na(best) or v < best
                    best := v
    best
originLowBar() =>
    float best = na
    int bestBar = na
    n = array.size(plBar)
    if n > 0
        for i = 1 to n
            idx = n - i
            b = array.get(plBar, idx)
            if bar_index - b <= legLook
                v = array.get(plVal, idx)
                if na(best) or v < best
                    best := v
                    bestBar := b
    bestBar

// ------------------------- State machines ----------------------------
var int   buStage = ST_IDLE
var int   buStageBar = na
var int   buSweepBar = na
var float buMSS = na
var float buCISD = na
var float buFvgTop = na
var float buFvgBot = na
var float buSweepLow = na
var float buLiqLow = na

var int   beStage = ST_IDLE
var int   beStageBar = na
var int   beSweepBar = na
var float beMSS = na
var float beCISD = na
var float beFvgTop = na
var float beFvgBot = na
var float beSweepHigh = na
var float beLiqHigh = na

// [FIX-4] POI touch latches
var int poiTouchBarB = na
var int poiTouchBarS = na

var int   lastDir = 0
var int   lastSigBar = na
var int   lastSigTime = na
var float sigMSS = na
var float sigCISD = na
var float sigIfvgTop = na
var float sigIfvgBot = na
var float sigSLsafe = na
var float sigSLagg = na

buySignal  = false
sellSignal = false

if barstate.isconfirmed and bar_index > structLen * 2 + sweepLen * 2 + legLook + 4
    // ---- record confirmed pivots -------------------------------------
    if not na(phS)
        array.push(phVal, phS)
        array.push(phBar, bar_index - structLen)
        if array.size(phVal) > 200
            array.shift(phVal)
            array.shift(phBar)
    if not na(plS)
        array.push(plVal, plS)
        array.push(plBar, bar_index - structLen)
        if array.size(plVal) > 200
            array.shift(plVal)
            array.shift(plBar)
    if not na(plL)
        liqLow := plL
        liqLowBar := bar_index - sweepLen
    if not na(phL)
        liqHigh := phL
        liqHighBar := bar_index - sweepLen

    // ---- [FIX-4] latch POI touches -----------------------------------
    if not na(supTop) and low <= supTop + tol and high >= supBot - tol
        poiTouchBarB := bar_index
    if not na(resTop) and high >= resBot - tol and low <= resTop + tol
        poiTouchBarS := bar_index

    // ===================== BULLISH =====================
    // [FIX-2] invalidation before anything else
    if buStage != ST_IDLE and low < buSweepLow
        buStage := ST_IDLE
    if buStage >= ST_IFVG and close < buFvgBot
        buStage := ST_IDLE
    if buStage != ST_IDLE and bar_index - buSweepBar > maxBars
        buStage := ST_IDLE

    if buStage == ST_IDLE and not na(liqLow) and not na(supTop)
        inPOI = not na(poiTouchBarB) and bar_index - poiTouchBarB <= legLook
        swept = low < liqLow and close > liqLow
        if inPOI and swept
            oh    = originHighVal()
            ohBar = originHighBar()
            if not na(oh) and not na(ohBar)
                hAge = bar_index - ohBar
                legOk = not needLegLow or isLegLow(hAge)
                if hAge >= 3 and hAge <= legLook and legOk
                    cisd = firstRedOpenAfter(hAge)
                    ft   = bearFvgTopAfter(hAge)
                    fb   = bearFvgBotAfter(hAge)
                    // [FIX-6] >= stacking, and iFVG must NOT be pre-taken
                    if not na(cisd) and not na(ft) and not na(fb) and oh >= cisd and cisd >= ft and ft > low and close < ft
                        buStage := ST_SWEPT
                        buStageBar := bar_index
                        buSweepBar := bar_index
                        buMSS := oh
                        buCISD := cisd
                        buFvgTop := ft
                        buFvgBot := fb
                        buSweepLow := low
                        buLiqLow := liqLow          // [FIX-3] freeze
    // [FIX-5] each stage on a strictly later bar
    if buStage == ST_SWEPT and (not strictSeq or bar_index > buStageBar) and close > buFvgTop
        buStage := ST_IFVG
        buStageBar := bar_index
    if buStage == ST_IFVG and (not strictSeq or bar_index > buStageBar) and close > buCISD
        buStage := ST_CISD
        buStageBar := bar_index
    if buStage == ST_CISD and (not strictSeq or bar_index > buStageBar) and close > buMSS
        buySignal := true
        lastDir := 1
        lastSigBar := bar_index
        lastSigTime := time
        sigMSS := buMSS
        sigCISD := buCISD
        sigIfvgTop := buFvgTop
        sigIfvgBot := buFvgBot
        sigSLsafe := buSweepLow
        sigSLagg := nz(buLiqLow, buSweepLow)        // [FIX-3] frozen
        buStage := ST_IDLE

    // ===================== BEARISH =====================
    if beStage != ST_IDLE and high > beSweepHigh
        beStage := ST_IDLE
    if beStage >= ST_IFVG and close > beFvgTop
        beStage := ST_IDLE
    if beStage != ST_IDLE and bar_index - beSweepBar > maxBars
        beStage := ST_IDLE

    if beStage == ST_IDLE and not na(liqHigh) and not na(resTop)
        inPOI = not na(poiTouchBarS) and bar_index - poiTouchBarS <= legLook
        swept = high > liqHigh and close < liqHigh
        if inPOI and swept
            ol    = originLowVal()
            olBar = originLowBar()
            if not na(ol) and not na(olBar)
                hAge = bar_index - olBar
                legOk = not needLegLow or isLegHigh(hAge)
                if hAge >= 3 and hAge <= legLook and legOk
                    cisd = firstGreenOpenAfter(hAge)
                    ft   = bullFvgTopAfter(hAge)
                    fb   = bullFvgBotAfter(hAge)
                    if not na(cisd) and not na(ft) and not na(fb) and ol <= cisd and cisd <= fb and fb < high and close > fb
                        beStage := ST_SWEPT
                        beStageBar := bar_index
                        beSweepBar := bar_index
                        beMSS := ol
                        beCISD := cisd
                        beFvgTop := ft
                        beFvgBot := fb
                        beSweepHigh := high
                        beLiqHigh := liqHigh
    if beStage == ST_SWEPT and (not strictSeq or bar_index > beStageBar) and close < beFvgBot
        beStage := ST_IFVG
        beStageBar := bar_index
    if beStage == ST_IFVG and (not strictSeq or bar_index > beStageBar) and close < beCISD
        beStage := ST_CISD
        beStageBar := bar_index
    if beStage == ST_CISD and (not strictSeq or bar_index > beStageBar) and close < beMSS
        sellSignal := true
        lastDir := -1
        lastSigBar := bar_index
        lastSigTime := time
        sigMSS := beMSS
        sigCISD := beCISD
        sigIfvgTop := beFvgTop
        sigIfvgBot := beFvgBot
        sigSLsafe := beSweepHigh
        sigSLagg := nz(beLiqHigh, beSweepHigh)
        beStage := ST_IDLE

// ==================== MODULE 8 — drawing =============================
f_size() => dashSize == "Small" ? size.small : dashSize == "Large" ? size.large : size.normal

drawSignal() =>
    xr = bar_index + levelExtend
    x0 = nz(lastSigBar, bar_index)
    if drawLevels
        line.new(x0, sigMSS,  xr, sigMSS,  color = color.new(color.blue, 0),   width = 2)
        line.new(x0, sigCISD, xr, sigCISD, color = color.new(color.purple, 0), width = 2)
        label.new(xr, sigMSS,  " MSS · Entry 1",  style = label.style_none, textcolor = color.blue,   size = size.small)
        label.new(xr, sigCISD, " CISD · Entry 2", style = label.style_none, textcolor = color.purple, size = size.small)
    if drawZones
        box.new(x0, sigIfvgTop, xr, sigIfvgBot, border_color = color.new(color.aqua, 40), bgcolor = color.new(color.aqua, 82))
        label.new(xr, sigIfvgBot, " iFVG · Entry 3", style = label.style_none, textcolor = color.teal, size = size.small)
    if showSL
        line.new(x0, sigSLsafe, xr, sigSLsafe, color = color.new(color.red, 10),    style = line.style_dashed)
        line.new(x0, sigSLagg,  xr, sigSLagg,  color = color.new(color.orange, 10), style = line.style_dotted)
        label.new(xr, sigSLsafe, " SL safety", style = label.style_none, textcolor = color.red,    size = size.small)
        label.new(xr, sigSLagg,  " SL aggr.",  style = label.style_none, textcolor = color.orange, size = size.small)

if buySignal or sellSignal
    drawSignal()

// POI box + forming-setup lines (last bar only)
var box poiBoxB = na
var box poiBoxS = na
var line[]  liveLn = array.new_line()
var label[] liveLb = array.new_label()
pushLive(int x1, float p, string txt, color c, string st) =>
    xr = bar_index + levelExtend
    ls = st == "solid" ? line.style_solid : st == "dashed" ? line.style_dashed : line.style_dotted
    array.push(liveLn, line.new(x1, p, xr, p, color = c, style = ls))
    array.push(liveLb, label.new(xr, p, txt, style = label.style_none, textcolor = c, size = size.small))

if barstate.islast
    if not na(poiBoxB)
        box.delete(poiBoxB)
    if not na(poiBoxS)
        box.delete(poiBoxS)
    xl = math.max(0, bar_index - 80)                 // [FIX-9] never negative
    if drawZones and not na(supTop)
        poiBoxB := box.new(xl, supTop, bar_index + levelExtend, supBot, border_color = color.new(color.orange, 40), bgcolor = poiColor, text = "POI Buy", text_color = color.new(color.orange, 0), text_halign = text.align_left, text_size = size.small)
    if drawZones and not na(resTop) and not (useManBuy and useManSell)
        poiBoxS := box.new(xl, resTop, bar_index + levelExtend, resBot, border_color = color.new(color.orange, 40), bgcolor = poiColor, text = "POI Sell", text_color = color.new(color.orange, 0), text_halign = text.align_left, text_size = size.small)
    if drawLevels
        while array.size(liveLn) > 0
            line.delete(array.pop(liveLn))
        while array.size(liveLb) > 0
            label.delete(array.pop(liveLb))
        if buStage >= ST_SWEPT
            pushLive(buSweepBar, buMSS,    " MSS (await)", color.blue,   "solid")
            pushLive(buSweepBar, buCISD,   " CISD",        color.purple, "dotted")
            pushLive(buSweepBar, buFvgTop, " iFVG top",    color.aqua,   "dotted")
        if beStage >= ST_SWEPT
            pushLive(beSweepBar, beMSS,    " MSS (await)", color.blue,   "solid")
            pushLive(beSweepBar, beCISD,   " CISD",        color.purple, "dotted")
            pushLive(beSweepBar, beFvgBot, " iFVG bot",    color.aqua,   "dotted")

plotshape(buySignal,  title = "Buy",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.lime, 0), size = size.normal, text = "BUY")
plotshape(sellSignal, title = "Sell", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),  size = size.normal, text = "SELL")

// ==================== MODULE 8 — dashboard ===========================
dot(bool on)  => on ? "●" : "○"
dcol(bool on) => on ? color.new(#26a69a, 0) : color.new(color.gray, 45)
stName(int st, bool fired, bool poiOk, bool touched) => fired ? "ENTRY ✔" : st == ST_SWEPT ? "swept" : st == ST_IFVG ? "iFVG" : st == ST_CISD ? "await MSS" : (poiOk and not touched) ? "wait POI" : "idle"

var table dash = na
if showDash and barstate.islast
    buyFired  = lastSigBar == bar_index and lastDir == 1
    sellFired = lastSigBar == bar_index and lastDir == -1
    poiB = not na(supTop)
    poiS = not na(resTop)
    touchedB = not na(poiTouchBarB) and bar_index - poiTouchBarB <= legLook
    touchedS = not na(poiTouchBarS) and bar_index - poiTouchBarS <= legLook
    ts   = f_size()
    pos  = dashPos == "Left" ? position.top_left : position.top_right

    if na(dash)
        dash := table.new(pos, 3, 15, border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
    table.clear(dash, 0, 0, 2, 14)
    table.cell(dash, 0, 0, "🎯 TheReversal R4 · POI " + poiMode, text_color = color.white, text_size = ts, bgcolor = color.new(#1f2937, 0))
    table.cell(dash, 1, 0, "BULL", text_color = color.new(color.lime, 0), text_size = ts, bgcolor = color.new(#1f2937, 0))
    table.cell(dash, 2, 0, "BEAR", text_color = color.new(color.red, 0),  text_size = ts, bgcolor = color.new(#1f2937, 0))

    rows = array.from("POI defined", "POI touched", "Liquidity Sweep", "iFVG", "CISD", "MSS ✔")
    bOn  = array.from(poiB, touchedB, buStage >= ST_SWEPT, buStage >= ST_IFVG, buStage >= ST_CISD, buyFired)
    sOn  = array.from(poiS, touchedS, beStage >= ST_SWEPT, beStage >= ST_IFVG, beStage >= ST_CISD, sellFired)
    for r = 0 to 5
        table.cell(dash, 0, r + 1, array.get(rows, r), text_color = color.new(color.silver, 0), text_size = ts)
        table.cell(dash, 1, r + 1, dot(array.get(bOn, r)), text_color = dcol(array.get(bOn, r)), text_size = ts)
        table.cell(dash, 2, r + 1, dot(array.get(sOn, r)), text_color = dcol(array.get(sOn, r)), text_size = ts)

    table.cell(dash, 0, 7, "status", text_color = color.new(color.silver, 0), text_size = ts)
    table.cell(dash, 1, 7, stName(buStage, buyFired, poiB, touchedB),  text_color = buyFired  ? color.lime : color.new(color.silver, 0), text_size = ts)
    table.cell(dash, 2, 7, stName(beStage, sellFired, poiS, touchedS), text_color = sellFired ? color.red  : color.new(color.silver, 0), text_size = ts)

    haveSig = not na(lastSigBar)
    dirTxt  = not haveSig ? "-" : lastDir == 1 ? "BUY ▲" : "SELL ▼"
    dCol    = not haveSig ? color.gray : lastDir == 1 ? color.lime : color.red
    tk      = format.mintick
    table.cell(dash, 0, 8, "── Latest signal ──", text_color = color.new(color.gray, 0), text_size = ts, bgcolor = color.new(#1f2937, 30))
    table.cell(dash, 1, 8, dirTxt, text_color = dCol, text_size = ts, bgcolor = color.new(#1f2937, 30))
    table.cell(dash, 2, 8, haveSig ? str.format_time(lastSigTime, "HH:mm", syminfo.timezone) : "-", text_color = color.new(color.silver, 0), text_size = ts, bgcolor = color.new(#1f2937, 30))
    table.cell(dash, 0, 9,  "Entry1 · MSS",  text_color = color.new(color.blue, 0),   text_size = ts)
    table.cell(dash, 1, 9,  haveSig ? str.tostring(sigMSS,  tk) : "-", text_color = color.new(color.silver, 0), text_size = ts)
    table.cell(dash, 0, 10, "Entry2 · CISD", text_color = color.new(color.purple, 0), text_size = ts)
    table.cell(dash, 1, 10, haveSig ? str.tostring(sigCISD, tk) : "-", text_color = color.new(color.silver, 0), text_size = ts)
    table.cell(dash, 0, 11, "Entry3 · iFVG", text_color = color.new(color.teal, 0),   text_size = ts)
    table.cell(dash, 1, 11, haveSig ? str.tostring(sigIfvgTop, tk) + "–" + str.tostring(sigIfvgBot, tk) : "-", text_color = color.new(color.silver, 0), text_size = ts)
    table.cell(dash, 0, 12, "SL safety",     text_color = color.new(color.red, 0),    text_size = ts)
    table.cell(dash, 1, 12, haveSig ? str.tostring(sigSLsafe, tk) : "-", text_color = color.new(color.silver, 0), text_size = ts)
    table.cell(dash, 0, 13, "SL aggressive", text_color = color.new(color.orange, 0), text_size = ts)
    table.cell(dash, 1, 13, haveSig ? str.tostring(sigSLagg, tk) : "-", text_color = color.new(color.silver, 0), text_size = ts)

// ------------------------- Alerts ------------------------------------
alertcondition(buySignal,  "TheReversal R4 Buy",  "BUY: POI+Sweep+iFVG+CISD+MSS confirmed")
alertcondition(sellSignal, "TheReversal R4 Sell", "SELL: POI+Sweep+iFVG+CISD+MSS confirmed")
